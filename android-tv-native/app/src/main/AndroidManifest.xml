<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".IPTVApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="BeamTV"
        android:banner="@drawable/app_banner"
        android:theme="@style/AppTheme"
        android:networkSecurityConfig="@xml/network_security_config">
        
        <!-- Launcher Activity - checks if portal is configured -->
        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@style/AppTheme.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <!-- Portal Setup Activity -->
        <activity
            android:name=".PortalSetupActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        
        <!-- Cloud Auth Activity -->
        <activity
            android:name=".CloudAuthActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.AppCompat.NoActionBar" />
        
        <!-- Main Activity - Netflix-style component-based architecture -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        
        <!-- Live TV Channels Activity -->
        <activity
            android:name=".LiveTVChannelsActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
    </application>

</manifest>
