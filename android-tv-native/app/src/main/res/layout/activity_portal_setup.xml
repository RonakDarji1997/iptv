<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- Left Side - Icon and Title -->
        <LinearLayout
            android:id="@+id/left_panel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.4"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="48dp">

            <ImageView
                android:id="@+id/panel_icon"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/ic_playlist_add"
                android:tint="#FFFFFFFF" />

            <TextView
                android:id="@+id/panel_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Playlist type"
                android:textColor="#FFFFFFFF"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/panel_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Select playlist type"
                android:textColor="#B0FFFFFF"
                android:textSize="16sp"
                android:gravity="center" />

            <!-- Cloud Sync Button -->
            <Button
                android:id="@+id/btnCloudSync"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="☁️ Setup Cloud Sync"
                android:textSize="16sp"
                android:textColor="@color/button_text_color"
                android:background="@drawable/button_background"
                android:padding="16dp"
                android:minWidth="200dp"/>

        </LinearLayout>

        <!-- Right Side - Form Content -->
        <FrameLayout
            android:id="@+id/form_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.6"
            android:padding="48dp">

            <!-- Will be replaced with different forms -->

        </FrameLayout>

    </LinearLayout>

</FrameLayout>
