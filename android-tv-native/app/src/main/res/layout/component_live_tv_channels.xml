<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- Main Content (Preview + Channel List) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000">

        <!-- Top 30%: Preview (55%) + Channel Info (45%) -->
        <LinearLayout
            android:id="@+id/top_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="horizontal"
            android:background="#FF000000"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.30">

            <!-- Video Preview - 55% -->
            <FrameLayout
                android:id="@+id/preview_container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.55">
                
                <com.ronika.iptvnative.components.LiveTVPlayerComponent
                    android:id="@+id/live_tv_player"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>

            <!-- Channel Info - 45% -->
            <ScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.45"
                android:scrollbars="none"
                android:fillViewport="true">
                
                <LinearLayout
                    android:id="@+id/channel_info_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="#FF000000">

                    <TextView
                        android:id="@+id/preview_channel_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#FFFFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <!-- Now and Next Programs Side by Side -->
                    <LinearLayout
                        android:id="@+id/programs_row_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="14dp"
                        android:baselineAligned="false">

                        <!-- Current Program Section - 50% -->
                        <LinearLayout
                            android:id="@+id/current_program_container"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingEnd="8dp"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/current_program_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Now"
                                android:textColor="#AAFFFFFF"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/current_program_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#FFFFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:maxLines="2"
                                android:ellipsize="end" />

                            <TextView
                                android:id="@+id/current_program_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#AAFFFFFF"
                                android:textSize="11sp"
                                android:layout_marginTop="2dp" />

                            <!-- Progress Bar -->
                            <ProgressBar
                                android:id="@+id/current_program_progress"
                                style="@android:style/Widget.ProgressBar.Horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="3dp"
                                android:layout_marginTop="6dp"
                                android:max="100"
                                android:progress="0"
                                android:progressDrawable="@drawable/epg_progress_bar" />

                        </LinearLayout>

                        <!-- Next Program Section - 50% -->
                        <LinearLayout
                            android:id="@+id/next_program_container"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="8dp"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/next_program_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Next"
                                android:textColor="#AAFFFFFF"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/next_program_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#FFFFFFFF"
                                android:textSize="14sp"
                                android:maxLines="2"
                                android:ellipsize="end" />

                            <TextView
                                android:id="@+id/next_program_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#AAFFFFFF"
                                android:textSize="11sp"
                                android:layout_marginTop="2dp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>
            </ScrollView>

        </LinearLayout>

        <!-- Bottom 50%: Category Name + Channel Rows -->
        <LinearLayout
            android:id="@+id/bottom_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:paddingStart="60dp"
            android:paddingEnd="60dp"
            android:paddingTop="20dp"
            android:paddingBottom="30dp"
            app:layout_constraintTop_toBottomOf="@id/top_container"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Category Name -->
            <TextView
                android:id="@+id/category_name_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                android:text="News"
                android:textColor="#FFFFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <!-- EPG Container with Time Cursor overlay -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <!-- Main EPG Content -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <!-- EPG Time Header Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">

                        <!-- Spacer for channel info column -->
                        <Space
                            android:layout_width="370dp"
                            android:layout_height="wrap_content" />

                        <!-- Time Header Scroll Container -->
                        <HorizontalScrollView
                            android:id="@+id/time_header_scroll"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:scrollbars="none"
                            android:fillViewport="false">

                            <!-- Time markers container -->
                            <LinearLayout
                                android:id="@+id/time_header_container"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingBottom="8dp">
                                <!-- Time markers will be added programmatically -->
                            </LinearLayout>

                        </HorizontalScrollView>

                    </LinearLayout>

                    <!-- Channel Rows -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/channels_recycler"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:clipToPadding="false" />

                </LinearLayout>

                <!-- Current time cursor - full height overlay -->
                <View
                    android:id="@+id/time_cursor"
                    android:layout_width="2dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="370dp"
                    android:background="#FFFF0000"
                    android:visibility="visible" />

            </FrameLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Fullscreen Player Overlay (Initially GONE) -->
    <FrameLayout
        android:id="@+id/fullscreen_player_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">
        
        <com.ronika.iptvnative.components.LiveTVPlayerComponent
            android:id="@+id/live_tv_player_fullscreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

</FrameLayout>
