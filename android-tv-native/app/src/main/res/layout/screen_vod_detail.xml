<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vod_detail_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:visibility="gone">

    <!-- Backdrop Image -->
    <ImageView
        android:id="@+id/detail_poster_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />
    
    <!-- Gradient Overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_overlay" />
    
    <!-- Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="60dp"
        android:gravity="bottom">

        <!-- Category -->
        <TextView
            android:id="@+id/detail_category_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Title -->
        <TextView
            android:id="@+id/detail_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="48sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- Year -->
        <TextView
            android:id="@+id/detail_year"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#B3FFFFFF"
            android:textSize="18sp"
            android:layout_marginTop="8dp" />

        <!-- Description -->
        <TextView
            android:id="@+id/detail_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#CCFFFFFF"
            android:textSize="16sp"
            android:layout_marginTop="16dp"
            android:maxLines="3"
            android:ellipsize="end"
            android:lineSpacingExtra="4dp" />

        <!-- Cast/Director Info -->
        <TextView
            android:id="@+id/detail_cast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#99FFFFFF"
            android:textSize="14sp"
            android:layout_marginTop="12dp"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp">

                    <!-- Play Button -->
                    <Button
                        android:id="@+id/detail_play_button"
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:paddingStart="32dp"
                        android:paddingEnd="32dp"
                        android:text="▶ Play"
                        android:textColor="@color/button_text_color"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:background="@drawable/button_play"
                        android:layout_marginEnd="16dp"
                        android:focusable="true"
                        android:nextFocusRight="@+id/detail_favorite_button" />                    <!-- Add to Favorites Button -->
                    <Button
                        android:id="@+id/detail_favorite_button"
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:paddingStart="32dp"
                        android:paddingEnd="32dp"
                        android:text="Favorite"
                        android:textColor="@color/button_text_color"
                        android:drawableLeft="@drawable/ic_favorite_outline"
                        android:drawableStart="@drawable/ic_favorite_outline"
                        android:drawableTint="@color/button_text_color"
                        android:drawablePadding="12dp"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:background="@drawable/button_play"
                        android:focusable="true"
                        android:nextFocusLeft="@+id/detail_play_button" />        </LinearLayout>

    </LinearLayout>

</FrameLayout>
