<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="48dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Adult Content Protection"
            android:textColor="#FFFFFFFF"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Set a PIN to protect adult content (18+)"
            android:textColor="#99FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="48dp" />

        <!-- PIN Input Card -->
        <LinearLayout
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_box_background"
            android:padding="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter 4-digit PIN"
                android:textColor="#CCFFFFFF"
                android:textSize="14sp"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/input_pin"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/rounded_button_dark"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:gravity="center"
                android:inputType="numberPassword"
                android:maxLength="4"
                android:letterSpacing="0.5"
                android:hint="• • • •"
                android:textColorHint="#666666"
                android:focusable="true"
                android:focusableInTouchMode="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Confirm PIN"
                android:textColor="#CCFFFFFF"
                android:textSize="14sp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/input_pin_confirm"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/rounded_button_dark"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:gravity="center"
                android:inputType="numberPassword"
                android:maxLength="4"
                android:letterSpacing="0.5"
                android:hint="• • • •"
                android:textColorHint="#666666"
                android:focusable="true"
                android:focusableInTouchMode="true" />

            <!-- Error message -->
            <TextView
                android:id="@+id/error_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF5252"
                android:textSize="14sp"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="32dp">

            <Button
                android:id="@+id/btn_skip"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Skip"
                android:textColor="#FFFFFF"
                android:background="@drawable/rounded_button_dark"
                android:layout_marginEnd="12dp"
                android:focusable="true"
                android:focusableInTouchMode="true" />

            <Button
                android:id="@+id/btn_save"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Save PIN"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="@drawable/rounded_button_blue"
                android:focusable="true"
                android:focusableInTouchMode="true" />

        </LinearLayout>

        <!-- Info text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="You can change this later in Settings"
            android:textColor="#66FFFFFF"
            android:textSize="12sp"
            android:layout_marginTop="24dp" />

    </LinearLayout>
</FrameLayout>
