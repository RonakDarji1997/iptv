<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/series_detail_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:visibility="gone"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- Backdrop Area (Animated to hide when focus on episodes) -->
    <FrameLayout
        android:id="@+id/series_backdrop_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="top">

        <!-- Backdrop Image - 80% width and height, positioned at top-right -->
        <ImageView
            android:id="@+id/series_detail_backdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="top|end"
            android:scaleType="centerCrop" />

        <!-- Left fade gradient (covers left 40% of screen) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="@drawable/gradient_fade_left"
            android:id="@+id/fade_left" />

        <!-- Bottom fade gradient (covers bottom 40% of screen) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="bottom"
            android:background="@drawable/gradient_fade_bottom"
            android:id="@+id/fade_bottom" />

    </FrameLayout>

    <!-- Content ScrollView -->
    <ScrollView
        android:id="@+id/series_content_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="50dp"
            android:paddingEnd="30dp"
            android:paddingTop="40dp"
            android:paddingBottom="0dp">

            <!-- Info Area (Animated to hide) -->
            <LinearLayout
                android:id="@+id/series_info_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Series Title -->
                <TextView
                    android:id="@+id/series_detail_title"
                    android:layout_width="700dp"
                    android:layout_height="wrap_content"
                    android:text="Series Title"
                    android:textColor="#FFFFFF"
                    android:textSize="42sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:layout_marginBottom="10dp" />

                <!-- Year & Seasons & Rating -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/series_detail_year"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2024"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:layout_marginEnd="16dp" />

                    <TextView
                        android:id="@+id/series_detail_seasons"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3 Seasons"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:layout_marginEnd="16dp" />

                    <TextView
                        android:id="@+id/series_detail_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="★ 8.5"
                        android:textColor="#FFD700"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Genres Container -->
                <HorizontalScrollView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:id="@+id/series_genres_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="gone" />

                </HorizontalScrollView>

                <!-- Description -->
                <TextView
                    android:id="@+id/series_detail_description"
                    android:layout_width="700dp"
                    android:layout_height="wrap_content"
                    android:text="Series description goes here..."
                    android:textColor="#CCCCCC"
                    android:textSize="15sp"
                    android:lineHeight="22dp"
                    android:maxLines="4"
                    android:ellipsize="end"
                    android:layout_marginBottom="24dp" />

                <!-- Action Buttons -->
                <LinearLayout
                    android:id="@+id/series_action_buttons_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="24dp">

                    <Button
                        android:id="@+id/series_detail_play_button"
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:text="▶  Play"
                        android:textColor="@color/button_text_color"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:paddingStart="32dp"
                        android:paddingEnd="32dp"
                        android:background="@drawable/button_play"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:nextFocusRight="@id/series_detail_favorite_button"
                        android:layout_marginEnd="16dp" />

                    <Button
                        android:id="@+id/series_detail_favorite_button"
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:text="Favorite"
                        android:textColor="@color/button_text_color"
                        android:drawableLeft="@drawable/ic_favorite_outline"
                        android:drawableStart="@drawable/ic_favorite_outline"
                        android:drawableTint="@color/button_text_color"
                        android:drawablePadding="12dp"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:paddingStart="32dp"
                        android:paddingEnd="32dp"
                        android:background="@drawable/button_play"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:nextFocusLeft="@id/series_detail_play_button" />

                </LinearLayout>

            </LinearLayout>

            <!-- Episodes Tab (Like Prime Video) -->
            <TextView
                android:id="@+id/series_episodes_tab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Episodes"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- Season Selector -->
            <Spinner
                android:id="@+id/series_season_selector"
                android:layout_width="200dp"
                android:layout_height="50dp"
                android:background="@drawable/spinner_focus_bg"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusUp="@id/series_detail_play_button"
                android:nextFocusDown="@id/series_episodes_recycler"
                android:layout_marginBottom="24dp" />

            <!-- Episode Description (Updates dynamically) -->
            <TextView
                android:id="@+id/series_episode_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#CCCCCC"
                android:textSize="14sp"
                android:lineHeight="20dp"
                android:maxLines="3"
                android:ellipsize="end"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />

            <!-- Episodes Horizontal RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/series_episodes_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:clipToPadding="false" />

        </LinearLayout>

    </ScrollView>

    <!-- Loading Indicator -->
    <ProgressBar
        android:id="@+id/series_detail_loading"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="center"
        android:visibility="gone"
        android:indeterminateTint="#FFFFFFFF" />

    <!-- TMDB Loading Indicator -->
    <ProgressBar
        android:id="@+id/tmdb_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

</FrameLayout>
