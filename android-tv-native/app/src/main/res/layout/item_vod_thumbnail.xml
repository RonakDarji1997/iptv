<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="140dp"
    android:layout_height="210dp"
    android:layout_margin="0dp"
    android:padding="3dp"
    android:focusable="true"
    android:clickable="true"
    android:background="@drawable/selector_vod_thumbnail">

    <ImageView
        android:id="@+id/poster_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <!-- Series/Movie Indicator Badge - Top Right -->
    <TextView
        android:id="@+id/type_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:textColor="#FFFFFF"
        android:textSize="9sp"
        android:textStyle="bold"
        android:background="@drawable/type_badge_bg"
        android:visibility="gone" />

    <!-- Progress Bar - Red bar at bottom of image (above title) -->
    <FrameLayout
        android:id="@+id/progress_container"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="48dp"
        android:visibility="gone">
        
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#33FFFFFF" />
        
        <View
            android:id="@+id/progress_bar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="#FFFF0000" />
    </FrameLayout>

    <!-- Title Overlay at Bottom -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/gradient_title_overlay"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/title_overlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

    </LinearLayout>

</FrameLayout>
