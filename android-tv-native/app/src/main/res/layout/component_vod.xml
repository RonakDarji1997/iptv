<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- Main Grid View -->
    <LinearLayout
        android:id="@+id/vod_grid_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Backdrop Section - Split Layout (50% of screen height) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.50"
            android:orientation="horizontal"
            android:background="#FF000000">

            <!-- Left Side - Info Section (40%) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.40"
                android:orientation="vertical"
                android:paddingStart="40dp"
                android:paddingEnd="20dp"
                android:paddingTop="30dp"
                android:paddingBottom="30dp"
                android:clipToPadding="false">

                <TextView
                    android:id="@+id/category_name_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Movies"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/title_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFFFF"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/year_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#B3FFFFFF"
                    android:textSize="16sp"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/description_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#CCFFFFFF"
                    android:textSize="14sp"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginTop="10dp"
                    android:maxLines="5"
                    android:ellipsize="end" />

                <!-- Rating and Genre Info -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:id="@+id/rating_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="★ 8.5"
                        android:textColor="#FFD700"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/genre_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Action, Drama"
                        android:textColor="#B3FFFFFF"
                        android:textSize="13sp"
                        android:layout_marginStart="16dp"
                        android:visibility="gone" />

                </LinearLayout>

            </LinearLayout>

            <!-- Right Side - Backdrop Image (60%) -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.60">

                <!-- Backdrop Image -->
                <ImageView
                    android:id="@+id/backdrop_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:layout_gravity="center" />

                <!-- Subtle Gradient Overlay on Image -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/gradient_overlay" />

            </FrameLayout>

        </LinearLayout>

        <!-- Thumbnails Grid Section (50% of screen height) -->
        <com.ronika.iptvnative.components.CustomGridRecyclerView
            android:id="@+id/thumbnails_recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.50"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants" />

    </LinearLayout>

    <!-- Movie Detail View (Initially Hidden) -->
    <include layout="@layout/screen_vod_detail" />

    <!-- Series Detail View (Initially Hidden) -->
    <include layout="@layout/screen_series_detail" />

    <!-- Centered Loading Indicator -->
    <ProgressBar
        android:id="@+id/loading_indicator"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="center"
        android:visibility="gone"
        android:indeterminateTint="#FFFFFFFF" />

</FrameLayout>
