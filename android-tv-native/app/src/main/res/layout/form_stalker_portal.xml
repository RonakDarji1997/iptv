<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Server Address -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Server address"
            android:textColor="#AAFFFFFF"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/input_server"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:padding="16dp"
            android:hint="http://example.com/stalker_portal"
            android:textColor="@color/portal_input_text_color"
            android:textColorHint="@color/portal_input_hint_color"
            android:textSize="16sp"
            android:inputType="textUri"
            android:background="@drawable/portal_input_background"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <!-- MAC Address (editable) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="MAC address"
            android:textColor="#AAFFFFFF"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/input_mac_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:padding="16dp"
            android:hint="00:1A:79:XX:XX:XX"
            android:textColor="@color/portal_input_text_color"
            android:textColorHint="@color/portal_input_hint_color"
            android:textSize="16sp"
            android:inputType="text"
            android:background="@drawable/portal_input_background"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <!-- Username (optional) -->
        <EditText
            android:id="@+id/input_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="16dp"
            android:hint="Username (optional)"
            android:textColor="@color/portal_input_text_color"
            android:textColorHint="@color/portal_input_hint_color"
            android:textSize="16sp"
            android:inputType="text"
            android:background="@drawable/portal_input_background"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <!-- Password (optional) -->
        <EditText
            android:id="@+id/input_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="16dp"
            android:hint="Password (optional)"
            android:textColor="@color/portal_input_text_color"
            android:textColorHint="@color/portal_input_hint_color"
            android:textSize="16sp"
            android:inputType="textPassword"
            android:background="@drawable/portal_input_background"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <!-- Include TV Channels -->
        <LinearLayout
            android:id="@+id/toggle_tv_channels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:layout_marginTop="16dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:background="@drawable/portal_option_selector">

            <CheckBox
                android:id="@+id/checkbox_tv_channels"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:clickable="false"
                android:focusable="false"
                android:duplicateParentState="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Include TV channels"
                android:textColor="@color/portal_text_color"
                android:textSize="16sp"
                android:duplicateParentState="true" />

        </LinearLayout>

        <!-- Include VOD -->
        <LinearLayout
            android:id="@+id/toggle_vod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:layout_marginTop="8dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:background="@drawable/portal_option_selector">

            <CheckBox
                android:id="@+id/checkbox_vod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:clickable="false"
                android:focusable="false"
                android:duplicateParentState="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Include VOD"
                android:textColor="@color/portal_text_color"
                android:textSize="16sp"
                android:duplicateParentState="true" />

        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            android:gravity="end">

            <Button
                android:id="@+id/btn_connect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="Connect"
                android:textColor="@color/portal_text_color"
                android:textSize="16sp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:background="@drawable/portal_option_selector" />

            <Button
                android:id="@+id/btn_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:padding="16dp"
                android:text="Back"
                android:textColor="@color/portal_text_color"
                android:textSize="16sp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:background="@drawable/portal_option_selector" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
