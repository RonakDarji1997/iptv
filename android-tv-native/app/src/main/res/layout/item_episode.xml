<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/episode_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginBottom="16dp"
    android:focusable="true"
    android:clickable="true"
    android:background="@drawable/episode_card_bg"
    android:padding="0dp">

    <!-- Episode Thumbnail -->
    <ImageView
        android:id="@+id/episode_thumbnail"
        android:layout_width="200dp"
        android:layout_height="112dp"
        android:scaleType="centerCrop"
        android:background="#1a1a1a"
        android:contentDescription="Episode Thumbnail" />

    <!-- Episode Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_gravity="center_vertical">

        <TextView
            android:id="@+id/episode_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="E1. Episode Title"
            android:textColor="#ffffff"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/episode_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Episode description from TMDB"
            android:textColor="#999999"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:lineHeight="18dp"
            android:layout_marginBottom="4dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/episode_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="45 min"
            android:textColor="#666666"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
