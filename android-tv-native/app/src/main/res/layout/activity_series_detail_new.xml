<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Backdrop Image (Full screen) -->
    <ImageView
        android:id="@+id/backdrop_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="Series Backdrop" />

    <!-- Removed left overlay gradient to fix double image issue -->

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="50dp"
            android:paddingEnd="30dp"
            android:paddingTop="40dp"
            android:paddingBottom="40dp">

            <!-- Back Button -->
            <Button
                android:id="@+id/back_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← BACK"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/button_back_floating"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_marginBottom="40dp"
                android:focusable="true"
                android:focusableInTouchMode="true" />

            <!-- Hero Section Container (hidden initially, shown when dropdown focused) -->
            <LinearLayout
                android:id="@+id/hero_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

            <!-- Series Title -->
            <TextView
                android:id="@+id/series_title"
                android:layout_width="700dp"
                android:layout_height="wrap_content"
                android:text="Series Title"
                android:textColor="#FFFFFF"
                android:textSize="42sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginBottom="10dp" />

            <!-- Meta Row (IMDb Rating, Year, Seasons) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <!-- IMDb Rating -->
                <LinearLayout
                    android:id="@+id/rating_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/rating_badge_bg"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_marginEnd="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="IMDb"
                        android:textColor="#000000"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/series_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="8.5"
                        android:textColor="#000000"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="/10"
                        android:textColor="#000000"
                        android:textSize="10sp"
                        android:layout_marginStart="1dp" />

                </LinearLayout>

                <!-- Year -->
                <TextView
                    android:id="@+id/series_year"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2020"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:layout_marginEnd="16dp"
                    android:visibility="gone" />

                <!-- Total Seasons -->
                <TextView
                    android:id="@+id/series_seasons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3 Seasons"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Description -->
            <LinearLayout
                android:id="@+id/description_container"
                android:layout_width="700dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/series_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Series description goes here..."
                    android:textColor="#CCCCCC"
                    android:textSize="15sp"
                    android:lineHeight="22dp"
                    android:maxLines="4"
                    android:ellipsize="end" />

            </LinearLayout>

            <!-- Genres -->
            <LinearLayout
                android:id="@+id/genres_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp"
                android:visibility="gone">
                <!-- Genre chips added dynamically -->
            </LinearLayout>

            <!-- Buttons Row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="40dp">

                <!-- Play Button -->
                <Button
                    android:id="@+id/play_button"
                    android:layout_width="180dp"
                    android:layout_height="wrap_content"
                    android:text="▶ Play S1 E1"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif"
                    android:background="@drawable/button_play_focus"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:layout_marginEnd="12dp"
                    android:focusable="true"
                    android:focusableInTouchMode="true" />

            </LinearLayout>

            </LinearLayout>
            <!-- End Hero Section -->

            <!-- Episodes Section (visible initially) -->
            <TextView
                android:id="@+id/episodes_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Episodes"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- Season Selector & Episodes Label -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/season_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Season"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="12dp" />

                <Spinner
                    android:id="@+id/season_spinner"
                    android:layout_width="140dp"
                    android:layout_height="44dp"
                    android:background="@drawable/spinner_focus_bg"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:focusable="true" />

            </LinearLayout>

            <!-- Episodes Container (dynamically populated) -->
            <LinearLayout
                android:id="@+id/seasons_episodes_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <!-- Episode items will be added here -->
            </LinearLayout>

            <!-- Loading Indicator -->
            <ProgressBar
                android:id="@+id/episodes_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="40dp"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>

    <!-- TMDB Loading Indicator -->
    <ProgressBar
        android:id="@+id/tmdb_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

</FrameLayout>
