<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="2dp"
    android:paddingBottom="2dp"
    android:focusable="true"
    android:clickable="true"
    android:background="@android:color/transparent">

    <!-- Left: Channel Info (Fixed width, Focusable) -->
    <LinearLayout
        android:id="@+id/channel_info"
        android:layout_width="350dp"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:focusable="true"
        android:clickable="true"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:background="@drawable/channel_row_normal">

        <!-- Play Icon (visible when channel is playing in preview) -->
        <ImageView
            android:id="@+id/play_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="4dp"
            android:src="@android:drawable/ic_media_play"
            android:tint="#00FF00"
            android:visibility="gone" />

        <TextView
            android:id="@+id/channel_number"
            android:layout_width="45dp"
            android:layout_height="wrap_content"
            android:text="1"
            android:textColor="#FFFFFFFF"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="start" />

        <ImageView
            android:id="@+id/channel_logo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_tv_placeholder" />

        <TextView
            android:id="@+id/channel_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="RUSSIA TODAY 4K"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- Margin between channel info and EPG -->
    <Space
        android:layout_width="20dp"
        android:layout_height="match_parent" />

    <!-- Right: EPG Timeline (Scrollable) -->
    <HorizontalScrollView
        android:id="@+id/epg_scroll_view"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/epg_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- EPG slots will be added programmatically -->

        </LinearLayout>

    </HorizontalScrollView>

</LinearLayout>
