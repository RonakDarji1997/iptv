<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Left fade (black to transparent) -->
    <item>
        <shape>
            <gradient
                android:angle="0"
                android:startColor="#FF000000"
                android:centerColor="#DD000000"
                android:endColor="#00000000"
                android:type="linear" />
        </shape>
    </item>
    
    <!-- Bottom fade (black to transparent, starts from bottom edge) -->
    <item
        android:top="300dp">
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#FF000000"
                android:endColor="#00000000"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
