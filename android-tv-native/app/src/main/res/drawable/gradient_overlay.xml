<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Left to right gradient (black to transparent) - fades left side to show image on right -->
    <item>
        <shape>
            <gradient
                android:startColor="#EE000000"
                android:centerColor="#88000000"
                android:endColor="#00000000"
                android:angle="0" />
        </shape>
    </item>
    <!-- Bottom gradient for text readability -->
    <item>
        <shape>
            <gradient
                android:startColor="#00000000"
                android:endColor="#BB000000"
                android:angle="270" />
        </shape>
    </item>
</layer-list>
