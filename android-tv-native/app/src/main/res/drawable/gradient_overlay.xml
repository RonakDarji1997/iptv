<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Right to left gradient (image dissolves to black on left) -->
    <item>
        <shape>
            <gradient
                android:startColor="#00000000"
                android:centerColor="#55000000"
                android:endColor="#FF000000"
                android:angle="180" />
        </shape>
    </item>
    <!-- Bottom gradient (image dissolves to black at bottom) -->
    <item>
        <shape>
            <gradient
                android:startColor="#00000000"
                android:endColor="#DD000000"
                android:angle="270" />
        </shape>
    </item>
</layer-list>
